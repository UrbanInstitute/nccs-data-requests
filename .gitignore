# THIS REPO IS PUBLIC. Confidential requester specifics never get committed —
# they live in a gitignored per-request _private.md.
requests/**/_private.md

# Local data pulls — provenance lives in each request's _pins.csv, not the
# bulk data. Keeps potentially large / non-public data out of the repo.
# Exception: the reproducible computation script IS tracked (public-safe code);
# ignore the directory *contents* (not the dir itself) so the negation works.
requests/**/data/*
!requests/**/data/_compute.R
*.parquet

# Quarto / knitr render artifacts (regenerated on render, incl. on the website)
/.quarto/
*_cache/
*_files/
*.html
!404.html

# R
.Rproj.user/
.Rhistory
.RData
.Ruserdata
.Renviron

# OS
.DS_Store

**/*.quarto_ipynb

# GitHub Pages site (published HTML guides)
!docs/**/*.html
!docs/*.html
